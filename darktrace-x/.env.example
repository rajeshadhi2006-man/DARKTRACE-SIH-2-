# ============================================================
# DARKTRACE-X ENVIRONMENT CONFIGURATION
# ============================================================

# Environment
APP_ENV=development
DEBUG=True
SECRET_KEY=darktrace_x_super_secret_jwt_hmac_sha256_key_do_not_share_in_prod
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=480

# API Configuration
API_V1_STR=/api
PROJECT_NAME=DARKTRACE-X

# Database - PostgreSQL
# In local dev without Docker, falls back gracefully to SQLite database: data/darktrace.db
DATABASE_URL=postgresql://darktrace_user:darktrace_password@postgres:5432/darktrace_db

# Graph Database - Neo4j
NEO4J_URI=bolt://neo4j:7687
NEO4J_USERNAME=neo4j
NEO4J_PASSWORD=darktrace_neo4j_password

# Cache & Message Broker - Redis / Celery
REDIS_URL=redis://redis:6379/0
CELERY_BROKER_URL=redis://redis:6379/0
CELERY_RESULT_BACKEND=redis://redis:6379/1

# AI / ML Service Configuration
AI_PROVIDER=mock  # Options: mock | openai | anthropic
AI_API_KEY=
EMBEDDING_MODEL=all-MiniLM-L6-v2

# Security & CORS
CORS_ORIGINS=["http://localhost:3000","http://localhost:5173","http://127.0.0.1:3000","http://127.0.0.1:5173"]

# File Upload Limits
MAX_UPLOAD_SIZE_BYTES=52428800 # 50 MB
ALLOWED_FILE_EXTENSIONS=["csv","json"]
